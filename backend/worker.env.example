# Worker node environment — copy to .env on each worker EC2

# ── Worker identity ──────────────────────────────────────────────────────────
WORKER_PORT=4000
WORKER_ID=worker1                              # unique per node (hostname works)
WORKER_URL=http://worker1.yourdomain.com:4000  # publicly reachable URL of this node
WORKER_CAPACITY=24                             # max concurrent workspace containers

# ── Orchestrator (API server) ────────────────────────────────────────────────
ORCHESTRATOR_URL=http://api.yourdomain.com:3001

# ── Auth (must match API server) ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret

# ── S3 workspace persistence ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_WORKSPACE_BUCKET=your-workspace-bucket     # leave blank to disable S3 sync
